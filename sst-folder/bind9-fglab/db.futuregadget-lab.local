;
; BIND data file for local loopback interface
;
$TTL	604800
@	IN	SOA	ns.futuregadget-lab.local. admin.futuregadget-lab.local. (
			      2		; Serial
			 604800		; Refresh
			  86400		; Retry
			2419200		; Expire
			 604800 )	; Negative Cache TTL
;
	IN	NS	ns.futuregadget-lab.local.
@	IN	A	10.20.50.105
ns	IN	A	10.20.50.105
www	IN	A	192.168.4.3
dom1	IN	A	192.168.4.35
dom2	IN	A	192.168.4.67
dom3	IN	A	192.168.4.99
dom4	IN	A	192.168.4.131
dom5	IN	A	192.168.4.163
dom6	IN	A	192.168.4.195
dom7	IN	A	192.168.4.227
