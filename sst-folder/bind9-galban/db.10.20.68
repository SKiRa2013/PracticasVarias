;
; BIND reverse data file for local loopback interface
;
$TTL	604800
@	IN	SOA	gabrielalban.net. root.gabrielalban.net. (
			      3		; Serial
			 604800		; Refresh
			  86400		; Retry
			2419200		; Expire
			 604800 )	; Negative Cache TTL
;

@	IN	NS	gabrielalban.net.

190	IN	PTR	dns.gabrielalban.net.
