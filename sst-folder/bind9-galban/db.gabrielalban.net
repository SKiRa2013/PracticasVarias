;
; BIND data file for local loopback interface
;
$TTL	604800
@	IN	SOA	gabrielalban.net. root.gabrielalban.net. (
			      3		; Serial
			 604800		; Refresh
			  86400		; Retry
			2419200		; Expire
			 604800 )	; Negative Cache TTL
;
	IN	NS	dns.gabrielalban.net.

dns		IN	A	10.20.68.190
@		IN	A	10.20.68.190
www		IN	A	10.20.68.190
intranet	IN	A	10.20.68.190
correo		IN	A	10.20.68.190
