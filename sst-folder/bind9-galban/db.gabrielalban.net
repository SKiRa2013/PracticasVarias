;
; BIND data file for local loopback interface
;
$TTL	604800
@	IN	SOA	gabrielalban.net. root.gabrielalban.net. (
			      5		; Serial
			 604800		; Refresh
			  86400		; Retry
			2419200		; Expire
			 604800 )	; Negative Cache TTL
;
	IN	NS	dns.gabrielalban.net.

dns		IN	A	10.20.68.106
@		IN	A	10.20.68.106
www		IN	A	10.20.68.106
intranet	IN	A	10.20.68.106
correo		IN	A	10.20.68.106
mail		CNAME	correo.gabrielalban.net.
zeus		IN	A	10.20.68.106
