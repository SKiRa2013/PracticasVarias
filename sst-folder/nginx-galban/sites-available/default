server {
	listen 8080 default_server;
	listen [::]:8080 default_server;

	root /var/www/galban;
	index index.html index.htm index.nginx-debian.html;

	server_name _;

	location / {
		try_files $uri $uri/ =404;
	}

	access_log /var/log/nginx/default_access.log;
	error_log /var/log/nginx/default_error.log;
}

